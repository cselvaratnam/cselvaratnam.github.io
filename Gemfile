source "https://rubygems.org"

# Mirrors the exact gem versions GitHub Pages runs, so a local preview matches
# the live build. Only needed for previewing locally — GitHub does not read it.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-include-cache"
  gem "jekyll-remote-theme"
end

# No longer bundled with Ruby 3.0+, but Jekyll's local server needs it.
gem "webrick", "~> 1.8"
